{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/download.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "/api/download.py"
    },
    {
      "src": "/(.*)",
      "destination": "/server.ts"
    }
  ]
}
